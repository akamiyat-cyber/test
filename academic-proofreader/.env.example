# --- AI engine (Google Gemini) — server-side only, never NEXT_PUBLIC_ ---
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model (see src/config/models.ts; check
# https://ai.google.dev/gemini-api/docs/models for current model IDs)
# GEMINI_MODEL=gemini-3.5-flash

# --- Supabase (optional: app runs in localStorage-only mode without these) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key used for usage metering (usage_events inserts). Optional.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
